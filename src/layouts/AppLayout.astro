---
import BaseLayout from './BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  description: string;
  section: 'charge' | 'history';
}

const { title, description, section } = Astro.props;

const items = [
  {
    key: 'charge',
    href: '/cobrar',
    label: 'Cobrar',
    icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h4v-3',
  },
  { key: 'history', href: '/cobros', label: 'Cobros', icon: 'M4 6h16M4 12h16M4 18h10' },
] as const;
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-dvh flex-col md:flex-row">
    <nav
      class="order-last sticky bottom-0 z-10 grid grid-cols-2 border-t border-line bg-paper pb-[env(safe-area-inset-bottom)] md:order-first md:flex md:h-dvh md:w-24 md:flex-col md:gap-2 md:border-t-0 md:border-r md:px-3 md:py-6 lg:w-52"
      aria-label="Secciones"
    >
      <a href="/" class="hidden px-2 pb-4 text-xl md:block"><Wordmark /></a>
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={section === item.key ? 'page' : undefined}
            class:list={[
              'relative grid justify-items-center gap-1 py-2.5 text-[13px] font-medium md:rounded-xl md:py-3 lg:flex lg:items-center lg:gap-2.5 lg:px-3 lg:text-[15px]',
              section === item.key ? 'text-ink md:bg-off' : 'text-ink-soft',
            ]}
          >
            {section === item.key && (
              <span class="absolute top-0 left-[30%] right-[30%] h-[3px] bg-brand md:top-3 md:bottom-3 md:left-[-12px] md:right-auto md:h-auto md:w-[3px]" />
            )}
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            {item.label}
          </a>
        ))
      }
    </nav>
    <main class="min-w-0 flex-1">
      <slot />
    </main>
  </div>
</BaseLayout>
