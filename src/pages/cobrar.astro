---
import AppLayout from '../layouts/AppLayout.astro';
import ChargeFlow from '../components/ChargeFlow.svelte';
import ChargeList from '../components/ChargeList.astro';
import DaySummary from '../components/DaySummary.astro';
import { startOfTodayMx } from '../lib/charge';
import { peyMock } from '../lib/pey';
import { getStore } from '../lib/store';

const store = await getStore();
const charges = await store.listSince(Astro.locals.user!.uid, startOfTodayMx());
---

<AppLayout title="Cobrar · DeUna" description="Cobra con QR o envía el cobro al celular de tu cliente." section="charge">
  <div class="grid h-[calc(100dvh-64px)] md:h-dvh lg:grid-cols-[2fr_1fr]">
    <ChargeFlow client:load mock={peyMock} />
    <aside class="hidden min-h-0 flex-col gap-4 overflow-auto border-l border-line px-6 py-6 lg:flex" aria-label="Cobros de hoy">
      <DaySummary charges={charges} />
      <ChargeList charges={charges.slice(0, 8)} />
      <a href="/cobros" class="text-sm text-ink-soft underline underline-offset-4">Tus cobros</a>
    </aside>
  </div>
</AppLayout>
