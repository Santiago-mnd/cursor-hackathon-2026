---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';

const signedIn = Boolean(Astro.locals.user);

const CHARGED = 5;
const formatSigned = (value: number) => `${value < 0 ? '−' : ''}$${Math.abs(value).toFixed(2)}`;
const percentOf = (value: number) => Math.round((value / CHARGED) * 100);

const receipts = [
  {
    title: 'Cobro real',
    titlePrefix: '',
    highlight: false,
    rows: [
      { label: 'Cobro', value: CHARGED },
      { label: 'Cargo de la app', value: -4.84 },
    ],
    keptLabel: 'Le quedaron',
    kept: 0.16,
    percentLabel: `${percentOf(0.16)} % del cobro`,
    barLabel: `De este cobro de $5.00, al vendedor le quedaron $0.16: el ${percentOf(0.16)} %.`,
  },
  {
    title: 'Con DeUna',
    titlePrefix: 'Con',
    highlight: true,
    rows: [
      { label: 'Cobro', value: CHARGED },
      { label: 'Comisión de DeUna', value: 0 },
    ],
    keptLabel: 'Te quedan',
    kept: CHARGED,
    percentLabel: `${percentOf(CHARGED)} % del cobro`,
    barLabel: `Con DeUna, de este cobro de $5.00 te quedan $5.00: el ${percentOf(CHARGED)} %.`,
  },
];
---

<BaseLayout
  title="DeUna · Cobra completo, aunque no traigan efectivo"
  description="Cobra desde tu celular con CoDi. El dinero llega directo a tu cuenta bancaria, sin comisión por cobro."
>
  <header class="mx-auto flex max-w-5xl items-center justify-between px-5 py-5 md:px-8">
    <Wordmark class="text-2xl" />
    <a
      href={signedIn ? '/cobrar' : '/entrar'}
      class="inline-flex h-11 items-center rounded-[var(--radius-control)] border border-ink px-4 text-sm font-bold"
    >
      {signedIn ? 'Cobrar' : 'Entrar'}
    </a>
  </header>

  <main>
    <section class="bg-brand text-brand-ink">
      <div class="mx-auto grid max-w-5xl gap-10 px-5 py-12 md:grid-cols-[1fr_minmax(0,280px)] md:items-stretch md:gap-12 md:px-8 md:py-20">
        <div class="grid content-start gap-5">
          <p class="num text-sm tracking-wider uppercase">Cobra DeUna. Sigue vendiendo.</p>
          <h1 class="text-5xl leading-[1.02] font-bold tracking-tight text-balance md:text-7xl">
            Cobra completo, aunque no traigan efectivo
          </h1>
          <p class="max-w-[46ch] text-lg leading-snug">
            Con DeUna cobras desde tu celular con CoDi. El dinero llega directo a tu cuenta bancaria, sin comisión por cobro.
          </p>
          <a
            href="/cobrar"
            class="inline-flex h-14 w-full items-center justify-center rounded-[var(--radius-control)] bg-paper px-6 text-lg font-bold text-ink sm:w-auto sm:justify-self-start"
          >
            Haz tu primer cobro
          </a>
        </div>
        <figure class="flex flex-col items-center gap-3 md:items-stretch">
          <div class="w-full max-w-[280px] md:relative md:max-w-none md:flex-1">
            <img
              src="/comprobante-cobro.jpg"
              width="600"
              height="1050"
              alt="Comprobante real de una app de cobro: cobro de $5, cargo de $4.84 y total recibido de $0.16. La marca y los datos personales están tapados."
              class="w-full rounded-[var(--radius-card)] bg-paper md:absolute md:inset-0 md:h-full md:object-cover md:object-top"
            />
          </div>
          <figcaption class="text-center text-sm">Comprobante real de una app de cobro; tapamos la marca y los datos personales.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-8 px-5 py-14 md:px-8">
      <h2 class="text-4xl leading-[1.05] font-bold tracking-tight text-balance md:text-5xl">Cobró $5; le quedaron $0.16</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          receipts.map((receipt) => (
            <article
              class:list={[
                'grid content-start gap-4 rounded-[var(--radius-card)] p-5 md:p-6',
                receipt.highlight ? 'bg-paid' : 'border border-line bg-paper',
              ]}
            >
              <h3 class="text-lg font-bold">
                {receipt.highlight ? (
                  <>
                    {receipt.titlePrefix} <Wordmark />
                  </>
                ) : (
                  receipt.title
                )}
              </h3>
              <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-lg">
                {receipt.rows.map((row) => (
                  <>
                    <dt class={receipt.highlight ? '' : 'text-ink-soft'}>{row.label}</dt>
                    <dd class:list={['num text-right', row.value < 0 && 'text-fail-ink']}>{formatSigned(row.value)}</dd>
                  </>
                ))}
                <div class="col-span-2 my-1 border-t border-dashed border-ink" aria-hidden="true" />
                <dt class="self-center font-bold">{receipt.keptLabel}</dt>
                <dd class="num text-right text-2xl font-bold">{formatSigned(receipt.kept)}</dd>
              </dl>
              <div class="grid gap-2">
                <div
                  class:list={['h-3 overflow-hidden rounded-full', receipt.highlight ? 'bg-paper/60' : 'bg-off']}
                  role="img"
                  aria-label={receipt.barLabel}
                >
                  <div
                    class:list={['h-full min-w-1 rounded-full', receipt.highlight ? 'bg-paid-ink' : 'bg-fail-ink']}
                    style={`width: ${(receipt.kept / CHARGED) * 100}%`}
                  />
                </div>
                <span class="num text-sm font-medium" aria-hidden="true">{receipt.percentLabel}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-4 px-5 py-14 md:px-8">
      <h2 class="text-3xl font-bold">Cobrar desde tu celular</h2>
      <p class="max-w-[60ch] text-lg leading-snug">
        Abre DeUna en el navegador; no tienes que descargar nada. Si tienes al cliente enfrente, muéstrale el QR para que lo
        escanee con la app de su banco. También puedes mandarle el cobro a su celular con su número de 10 dígitos. Cuando
        pague, la pantalla cambia sola a «¡Pagado!».
      </p>
    </section>

    <section class="bg-stage">
      <div class="mx-auto grid max-w-5xl gap-4 px-5 py-14 md:px-8">
        <h2 class="text-3xl font-bold">Tu venta a la vista</h2>
        <p class="max-w-[60ch] text-lg leading-snug">
          El dinero llega directo a tu cuenta, de banco a banco, por CoDi; DeUna no te cobra comisión por cobro. En Cobros ves
          cuánto cobraste hoy, cuántos cobros hiciste y el estado de cada uno.
        </p>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-4 px-5 py-14 md:px-8">
      <h2 class="text-3xl font-bold">Preguntas frecuentes</h2>
      <div class="grid gap-1">
        <h3 class="text-lg font-bold">¿Necesito descargar una app?</h3>
        <p class="text-ink-soft">No. Abre DeUna en el navegador de tu celular; si quieres, agrégala a tu pantalla de inicio.</p>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl justify-items-start gap-4 px-5 pb-20 md:px-8">
      <p class="text-3xl font-bold text-balance">Cobra <Wordmark /> Sigue vendiendo.</p>
      <a
        href="/cobrar"
        class="inline-flex h-14 w-full items-center justify-center rounded-[var(--radius-control)] bg-brand px-6 text-lg font-bold text-brand-ink sm:w-auto"
      >
        Haz tu primer cobro
      </a>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-5 py-6 text-sm text-ink-soft md:px-8">
      <Wordmark />
      <span>Hecho en Cursor Hackatón México CDMX, noviembre de 2026; con CoDi y la API de pey.</span>
    </div>
  </footer>
</BaseLayout>
