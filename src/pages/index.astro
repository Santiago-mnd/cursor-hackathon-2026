  description="Cobros con CoDi para el comercio informal: QR en persona, cobro al celular a distancia y sin comisión."
>
  <main class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-4xl font-bold">Cobra sin comisión</h1>
    <p class="mt-4 text-muted">
      Cobros con CoDi para tu puesto: QR en persona y cobro al celular a distancia.
    </p>
  </main>
</BaseLayout>
