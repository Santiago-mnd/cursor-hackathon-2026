---
import AppLayout from '../layouts/AppLayout.astro';
import SignOutButton from '../components/SignOutButton.svelte';

const user = Astro.locals.user!;
---

<AppLayout title="Tu cuenta · DeUna" description="Consulta tu nombre y correo de Google, o cierra sesión." section="account">
  <div class="mx-auto flex max-w-2xl flex-col gap-6 px-5 pt-6 pb-24 md:px-8 md:pb-8">
    <h1 class="text-2xl font-bold">Tu cuenta</h1>
    <div>
      {
        user.picture ? (
          <img src={user.picture} alt="" width="64" height="64" referrerpolicy="no-referrer" class="size-16 rounded-full bg-off" />
        ) : (
          <span class="grid size-16 place-items-center rounded-full bg-ink text-2xl font-bold text-paper" aria-hidden="true">
            {(user.name || user.email || '?').charAt(0).toUpperCase()}
          </span>
        )
      }
    </div>
    <dl class="grid gap-3 rounded-[var(--radius-card)] border border-line p-5">
      <div class="grid gap-0.5">
        <dt class="text-sm text-ink-soft">Nombre</dt>
        <dd class="text-lg">{user.name || '—'}</dd>
      </div>
      <div class="grid gap-0.5">
        <dt class="text-sm text-ink-soft">Correo de Google</dt>
        <dd class="text-lg break-all">{user.email || '—'}</dd>
      </div>
    </dl>
    <section class="grid gap-1.5 rounded-[var(--radius-card)] bg-off p-5" aria-labelledby="deposit-account-title">
      <h2 id="deposit-account-title" class="text-lg font-bold">Cuenta para cobros</h2>
      <p class="text-base leading-snug">
        Durante la demo, todos los cobros por QR o al celular llegan a una sola cuenta de prueba; el dinero no te llega a ti. Buscamos
        que puedas registrar tu CLABE para recibir tus cobros directamente.
      </p>
    </section>
    <SignOutButton client:load />
  </div>
</AppLayout>
