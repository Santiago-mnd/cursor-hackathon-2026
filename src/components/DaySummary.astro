---
import { formatMoney, type Charge } from '../lib/charge';

interface Props {
  charges: Charge[];
}

const { charges } = Astro.props;
const paid = charges.filter((charge) => charge.status === 'paid');
const total = paid.reduce((sum, charge) => sum + charge.amount, 0);
---

<div class="grid gap-1">
  <span class="text-sm text-ink-soft">Cobrado hoy · {paid.length} {paid.length === 1 ? 'cobro' : 'cobros'}</span>
  <span class="num text-5xl leading-none tracking-tight">{formatMoney(total)}</span>
</div>
<div class="flex items-center justify-between gap-3 rounded-[var(--radius-control)] bg-paid px-4 py-3.5">
  <span class="text-sm">Comisión de DeUna por cobro</span>
  <b class="num text-[22px] font-medium">$0.00</b>
</div>
